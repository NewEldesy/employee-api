# ============================================================
# Base de données
# ============================================================
DB_URL=jdbc:mysql://db:3306/employee_db
DB_USERNAME=employee_user
DB_PASSWORD=change_me

# Mot de passe root MySQL (utilisé par le service db dans compose.yaml)
MYSQL_ROOT_PASSWORD=change_me_root

# ============================================================
# JWT
# ============================================================
# Clé secrète HMAC-SHA256 — minimum 32 caractères
JWT_SECRET=change-me-in-production-must-be-at-least-32-chars!!
JWT_EXPIRATION_MS=86400000

# ============================================================
# Bootstrap des comptes de développement
# Mettre APP_BOOTSTRAP_ENABLED=false en production
# ============================================================
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_USER_PASSWORD=change_me
APP_BOOTSTRAP_ADMIN_PASSWORD=change_me
